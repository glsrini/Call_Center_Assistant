# Optional grounded language generation. The deterministic retriever works without these.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional live ticket creation via GitHub Issues. Use a dedicated support repository.
GITHUB_TICKETS_REPO=owner/repository
GITHUB_TOKEN=

# Local SQLite fallback database (used when GitHub configuration is absent).
SMARTDESK_DB=smartdesk_tickets.sqlite3
HOST=127.0.0.1
PORT=7860

